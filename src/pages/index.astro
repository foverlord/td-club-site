---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Star from '../components/Star.astro';
import Sky from '../components/Sky.astro';
import Hill from '../components/Hill.astro';
import WaIcon from '../components/WaIcon.astro';
import { site, waUrl, groups, more, mini, wins, gallery, showPrices, picks, preschool, priceOf } from '../data';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*', { eager: true });
const ph = (n: string) => {
  const m = Object.entries(files).find(([k]) => k.endsWith('/' + n))?.[1].default;
  if (!m) throw new Error('нет фото ' + n);
  return m;
};
const cap = (src: ImageMetadata, list: number[]) => {
  const w = list.filter((x) => x < src.width);
  return [...new Set([...w, Math.min(src.width, list[list.length - 1])])];
};
const gal = await Promise.all(gallery.map(async (g) => {
  const src = ph(g.src);
  const full = await getImage({ src, width: src.width, format: 'webp', quality: 82 });
  return { ...g, img: src, full: full.src };
}));
const galData = JSON.stringify(gal.map((g) => ({ full: g.full, cap: g.cap })));
const heroImg = ph('girls-painting.webp');
---
<Base title="TD Club — детский образовательный центр в Астане" description="TD Club (Talent Development Club) на Улы Дала, 31: подготовка к школе, мини-центр, английский, ИЗО-студия, танцы, шахматы, карате и продлёнка. 5,0 в 2ГИС.">
  <!-- 1. Герой на ночном небе -->
  <section class="hero" id="top" aria-labelledby="h1">
    <Sky seed={11} count={54} />
    <Star size={22} class="hero-s1" /><Star size={14} class="hero-s2" />
    <div class="wrap hero-in">
      <div class="hero-txt">
        <h1 id="h1">Детский образовательный центр в&nbsp;<span class="chalk">Астане</span></h1>
        <p class="hero-sub">Talent Development Club</p>
        <div class="hero-btns">
          <a class="btn btn-wa" href={waUrl()} target="_blank" rel="noopener" data-goal="wa_hero"><WaIcon /><span>Написать в WhatsApp</span></a>
          <a class="btn btn-chalk" href={`tel:${site.phoneE164}`} data-goal="call_hero">Позвонить</a>
        </div>
        <ul class="trust" aria-label="Коротко о центре">
          <li><a href={site.gis} target="_blank" rel="noopener"><span class="trust-star" aria-hidden="true">★</span><b>{site.rating.value}</b>&nbsp;· {site.rating.reviews} отзывов в 2ГИС</a></li>
          <li><span>Пн–пт до 20:30</span></li>
          <li><span>{site.station}</span></li>
          <li><a href={site.route} target="_blank" rel="noopener">Улы Дала, 31 · со стороны Сайран Арены</a></li>
        </ul>
      </div>
      <figure class="hero-ph">
        <Image src={heroImg} alt="Девочки рисуют красками за мольбертом в TD Club" widths={cap(heroImg, [400, 588])} sizes="(min-width: 1024px) 460px, 90vw" loading="eager" fetchpriority="high" format="webp" quality={82} />
      </figure>
    </div>
  </section>

  <!-- 1б. Подбор -->
  <section class="pick" id="podbor" aria-labelledby="pick-h" data-pick>
    <Sky seed={21} count={30} />
    <div class="wrap pick-in">
      <h2 id="pick-h">Что нравится ребёнку?</h2>
      <p class="pick-lead">Отметьте одно или несколько, и мы покажем подходящие занятия.</p>
      <div class="pick-btns" role="group" aria-label="Интересы ребёнка">
        {picks.map((p) => (
          <button type="button" class="pick-b" aria-pressed="false" data-pick-b={p.id}>
            <span class="pick-ic" aria-hidden="true">
              {p.id === 'move' && <svg viewBox="0 0 32 32"><circle cx="17" cy="6" r="3"/><path d="M15 11l-4 7 5 3-2 8M15 11l6 4 4-2M11 18l-5 1"/></svg>}
              {p.id === 'draw' && <svg viewBox="0 0 32 32"><path d="M6 26c3 0 5-2 5-5l12-13a2.5 2.5 0 0 1 3.5 3.5L14 24c-2 2-4.5 2.5-8 2z"/><path d="M20 11l3 3"/></svg>}
              {p.id === 'think' && <svg viewBox="0 0 32 32"><path d="M11 27h10M12 23h8l-1-6 3-3-2-5-5-3-3 2 1 3-4 4 2 2z"/></svg>}
              {p.id === 'talk' && <svg viewBox="0 0 32 32"><path d="M5 7h17v11H12l-5 4v-4H5z"/><path d="M22 12h5v10h-2v4l-4-4h-7"/></svg>}
            </span>
            <span class="pick-l">{p.label}</span>
          </button>
        ))}
      </div>
      <div class="pick-res" data-pick-res hidden>
        <ul class="pick-chips" data-pick-list aria-live="polite">
          {picks.flatMap((p) => p.items.map((t) => (
            <li data-for={p.id} hidden><label class="chip"><input type="checkbox" value={t} checked /><span>{t}{showPrices && <em>{priceOf(t) ?? 'цену уточнить'}</em>}</span></label></li>
          )))}
        </ul>
        <p class="pick-sub">Для дошкольников:</p>
        <ul class="pick-chips">
          {preschool.map((t) => <li><label class="chip"><input type="checkbox" value={t} /><span>{t}{showPrices && <em>{priceOf(t) ?? 'цену уточнить'}</em>}</span></label></li>)}
        </ul>
        {showPrices && <p class="pick-note">Цены по прайсу 2ГИС, период уточняйте в WhatsApp.</p>}
      </div>
      <a class="btn btn-wa pick-go" href={waUrl()} target="_blank" rel="noopener" data-pick-go data-goal="wa_pick"><WaIcon /><span>Спросить в WhatsApp</span></a>
    </div>
    <Hill />
  </section>

  <!-- 2. Направления -->
  <section class="sec" id="napravleniya" aria-labelledby="dir-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="dir-h">Направления</h2>
        {showPrices
          ? <p class="plaque">Цены по прайсу в 2ГИС на 14.11.2026.</p>
          : <p class="lead">Возраст, расписание и стоимость подскажем в WhatsApp.</p>}
      </div>
      <div class="groups">
        {groups.map((g) => {
          const src = ph(g.photo);
          return (
            <article class="grp" id={`g-${g.id}`}>
              <Image src={src} alt={g.alt} widths={cap(src, [360, 600])} sizes="(min-width: 1024px) 590px, (min-width: 640px) 45vw, 90vw" format="webp" quality={78} />
              <div class="grp-b">
                <h3>{g.title}</h3>
                <ul class="items">
                  {g.items.map((it) => (
                    <li><a href={waUrl(it.title)} target="_blank" rel="noopener" data-goal="wa_dir"><span class="it-txt"><span class="it-t">{it.title}</span>{showPrices && it.price && <><span class="it-p">{it.price}</span><small class="it-n">период уточняйте в WhatsApp</small></>}{it.note && <><small class="it-n">{it.note}</small>{showPrices && !it.price && <small class="it-n">цену уточняйте в WhatsApp</small>}</>}</span><span class="it-wa" aria-hidden="true"><WaIcon /></span></a></li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })}
      </div>
      <div class="more">
        <p>Ещё в центре:</p>
        <ul>{more.map((m) => <li><a href={waUrl(m)} target="_blank" rel="noopener" data-goal="wa_dir">{m}</a></li>)}</ul>
      </div>
    </div>
  </section>

  <!-- 3. Мини-центр -->
  <section class="sec sec--sky" id="mini" aria-labelledby="mini-h">
    <div class="wrap mini">
      <div class="mini-txt">
        <p class="kicker">Раннее развитие · {mini.age}</p>
        <h2 id="mini-h">{mini.title}</h2>
        <p class="lead">Для малышей: игры, конструктор, сюжетные занятия и первые шаги в группе.</p>
        {showPrices && <p class="mini-p">{mini.price}<small>период уточняйте в WhatsApp</small></p>}
        <a class="btn btn-night" href={waUrl('мини-центр')} target="_blank" rel="noopener" data-goal="wa_mini"><WaIcon /><span>Узнать о мини-центре</span></a>
      </div>
      <div class="mini-ph">
        {mini.photos.map((p, i) => {
          const src = ph(p.src);
          return <Image src={src} alt={p.alt} class={`mini-${i}`} widths={cap(src, [320, 600])} sizes="(min-width: 1024px) 300px, 45vw" format="webp" quality={78} />;
        })}
      </div>
    </div>
  </section>

  <!-- 4. Достижения и праздники -->
  <section class="sec" id="dostizheniya" aria-labelledby="win-h">
    <div class="wrap">
      <h2 id="win-h">Достижения и праздники</h2>
      <ul class="wins">
        {wins.map((w, i) => {
          const src = ph(w.src);
          return (
            <li class={`win win--${i}`}>
              <figure><Image src={src} alt={w.cap} widths={cap(src, [360, 605])} sizes={i > 2 ? '(min-width: 1024px) 590px, (min-width: 640px) 45vw, 90vw' : '(min-width: 1024px) 390px, (min-width: 640px) 45vw, 90vw'} format="webp" quality={78} /><figcaption>{w.cap}</figcaption></figure>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- 5. Летний лагерь -->
  <section class="sec" id="lager" aria-labelledby="camp-h">
    <div class="wrap">
      <div class="camp">
        <Sky seed={5} count={22} />
        <Star size={26} class="camp-star" />
        <p class="kicker">Лето в TD Club</p>
        <h2 id="camp-h">Летний лагерь</h2>
        <p class="lead">Даты смен, программу и условия расскажем в WhatsApp.</p>
        <a class="btn btn-wa" href={waUrl('летний лагерь')} target="_blank" rel="noopener" data-goal="wa_camp"><WaIcon /><span>Узнать условия</span></a>
      </div>
    </div>
  </section>

  <!-- 6. Галерея -->
  <section class="sec sec--sky" id="foto" aria-labelledby="gal-h">
    <div class="wrap">
      <h2 id="gal-h">Как проходят занятия</h2>
      <div class="gal" data-photos={galData}>
        {gal.map((g, i) => (
          <button type="button" class={`gal-i gal-i--${i}`} data-gal={i} aria-label={`Открыть фото: ${g.cap}`}>
            <Image src={g.img} alt={g.cap} widths={cap(g.img, [320, 600])} sizes="(min-width: 1024px) 300px, 50vw" format="webp" quality={76} />
          </button>
        ))}
      </div>
    </div>
    <dialog class="lb" data-lb aria-label="Просмотр фото">
      <figure><img data-lb-img alt="" /><figcaption data-lb-cap></figcaption></figure>
      <button type="button" class="lb-b lb-x" data-lb-close aria-label="Закрыть">×</button>
      <button type="button" class="lb-b lb-p" data-lb-step="-1" aria-label="Предыдущее фото">‹</button>
      <button type="button" class="lb-b lb-n" data-lb-step="1" aria-label="Следующее фото">›</button>
      <p class="lb-c" data-lb-count></p>
    </dialog>
  </section>

  <!-- 7. Отзывы -->
  <section class="sec" id="otzyvy" aria-labelledby="rev-h">
    <div class="wrap rev">
      <h2 id="rev-h" class="sr">Отзывы</h2>
      <p class="rev-n">{site.rating.value}</p>
      <p class="rev-s" aria-label="5 из 5">★★★★★</p>
      <p class="rev-t">{site.rating.reviews} отзывов и {site.rating.marks} оценок родителей в 2ГИС</p>
      <a class="btn btn-line" href={site.gis} target="_blank" rel="noopener">Читать отзывы в 2ГИС</a>
    </div>
  </section>

  <!-- 7б. Как прийти впервые -->
  <section class="sec" id="vpervye" aria-labelledby="first-h">
    <div class="wrap">
      <h2 id="first-h">Как прийти впервые</h2>
      <ol class="steps">
        <li><span class="st-n">1</span><b>Напишите в WhatsApp</b><a href={waUrl()} target="_blank" rel="noopener" data-goal="wa_steps">Открыть чат</a></li>
        <li><span class="st-n">2</span><b>Выберите направление и время</b></li>
        <li><span class="st-n">3</span><b>Приходите: Улы Дала 31, блок А3, подъезд 9</b><a href={site.route} target="_blank" rel="noopener">Маршрут в 2ГИС</a></li>
      </ol>
    </div>
  </section>

  <!-- 8. Контакты -->
  <section class="sec" id="kontakty" aria-labelledby="ct-h">
    <div class="wrap ct">
      <div>
        <h2 id="ct-h">Как нас найти</h2>
        <p class="ct-addr">{site.address}</p>
        <p class="ct-muted">{site.addressMore}; {site.station}.</p>
        <dl class="ct-hours">{site.hours.map(([d, h]) => <div><dt>{d}</dt><dd>{h}</dd></div>)}</dl>
        <p><a class="ct-phone" href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a></p>
        <p class="ct-muted">Оплата наличными, картой, переводом или по QR.</p>
        <div class="ct-btns">
          <a class="btn btn-wa" href={waUrl()} target="_blank" rel="noopener" data-goal="wa_contacts"><WaIcon /><span>Написать в WhatsApp</span></a>
          <a class="btn btn-line" href={site.route} target="_blank" rel="noopener">Маршрут в 2ГИС</a>
        </div>
      </div>
      <figure class="ct-map">
        <a href={site.gis} target="_blank" rel="noopener" aria-label="Открыть TD Club на карте 2ГИС">
          <Image src={ph('map-osm.webp')} alt="Карта: TD Club на проспекте Улы Дала, 31" widths={[500, 1000]} sizes="(min-width: 1024px) 560px, 100vw" format="webp" quality={74} />
        </a>
        <figcaption>Карта © участники OpenStreetMap</figcaption>
      </figure>
    </div>
  </section>
</Base>
